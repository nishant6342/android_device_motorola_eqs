cc_prebuilt_library_shared {
	name: "libv4a_re",
	owner: "v4a",
	strip: {
		none: true,
	},
	target: {
		android_arm64: {
			srcs: ["lib64/soundfx/libv4a_re.so"],
			shared_libs: ["liblog", "libm", "libdl", "libc",],
		},
	},
	compile_multilib: "64",
	relative_install_path: "soundfx",
	prefer: true,
	soc_specific: true,
}